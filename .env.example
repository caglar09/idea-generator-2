# Host directory where Claude Code projects will be exported (bind mounted to /projects)
PROJECTS_DIR=/Users/caglar/Desktop/ideas

# Container-side defaults
DEFAULT_PROJECTS_ROOT=/projects
DB_FILE=/app/data/ideas.db

# Local LLM servers running on the host machine
OLLAMA_BASE_URL=http://host.docker.internal:11434
MLX_BASE_URL=http://host.docker.internal:8080/v1
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Optional cloud provider API keys (never baked into image; runtime only)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
CUSTOM_API_KEY=
